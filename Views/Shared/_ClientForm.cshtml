@model VehicleRent.Models.ViewModels.ClientViewModel
@{
    var formAction = Model?.Id.HasValue == true ? "/Clients/Update" : "/Clients/Create";
}

<form id="clientFormStandalone" method="post" action="@formAction" class="vehicle-form card border-0 shadow-sm p-4 p-lg-5" novalidate>
  @Html.AntiForgeryToken()
  <input asp-for="Id" type="hidden" id="clientId" />
  <p class="form-caption mb-4">Campos com <span class="req-mark">*</span> sao obrigatorios.</p>
  <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

  <div class="row g-3">
    <div class="col-12 col-md-6">
      <div class="vehicle-field form-floating">
        <input asp-for="Name" class="form-control" id="clientName" placeholder="Nome completo" required maxlength="50" />
        <label for="clientName">Nome completo <span class="req-mark" aria-hidden="true">*</span></label>
        <div class="field-hint" data-field-hint-for="clientName">Preenche este campo.</div>
      </div>
    </div>

    <div class="col-12 col-md-6">
      <div class="vehicle-field form-floating">
        <input asp-for="Email" type="email" class="form-control" id="clientEmail" placeholder="Email" required maxlength="100" />
        <label for="clientEmail">Email <span class="req-mark" aria-hidden="true">*</span></label>
        <div class="field-hint" data-field-hint-for="clientEmail">Introduz um email valido.</div>
      </div>
    </div>

    <div class="col-12 col-md-6">
      <div class="vehicle-field form-floating">
        <input asp-for="PhoneNumber" class="form-control" id="clientPhoneNumber" placeholder="Telefone" required />
        <label for="clientPhoneNumber">Telefone <span class="req-mark" aria-hidden="true">*</span></label>
        <div class="field-hint" data-field-hint-for="clientPhoneNumber">Formato: +351912345678</div>
      </div>
    </div>

    <div class="col-12 col-md-6">
      <div class="vehicle-field form-floating">
        <input asp-for="DriverLicense" class="form-control" id="clientDriverLicense" placeholder="Carta de Conducao" required maxlength="30" />
        <label for="clientDriverLicense">Carta de Conducao <span class="req-mark" aria-hidden="true">*</span></label>
        <div class="field-hint" data-field-hint-for="clientDriverLicense">Preenche este campo.</div>
      </div>
    </div>
  </div>

  <div class="d-flex justify-content-end gap-2 mt-4">
    <a class="btn btn-outline-secondary" href="/Clients">Voltar</a>
    <button id="btnSaveClientStandalone" type="submit" class="btn btn-primary">Salvar</button>
  </div>
</form>
