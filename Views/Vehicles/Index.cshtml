@model VehicleRent.Models.Entities.PagedResult<VehicleRent.Models.ViewModels.VehicleViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Veiculos";
    var totalPages = Model.TotalPages;
    var currentPage = Model.Page <= 0 ? 1 : Model.Page;
    var pageSize = (Model.PageSize == 10 || Model.PageSize == 20 || Model.PageSize == 50) ? Model.PageSize : 10;
    var startPage = Math.Max(1, currentPage - 2);
    var endPage = Math.Min(totalPages, currentPage + 2);
}

<section class="vehicle-page py-4 py-lg-5">
  <div class="container">
    <div class="page-shell page-shell-wide mx-auto">
      <div class="d-flex justify-content-between align-items-start align-items-md-center flex-column flex-md-row gap-3 mb-4">
        <div>
          <p class="page-eyebrow mb-2">Gestao de frota</p>
          <h1 class="page-title mb-1">Veiculos</h1>
          <p class="page-subtitle mb-0">Lista atualizada da tua frota.</p>
        </div>
        <a class="btn btn-success" asp-controller="Vehicles" asp-action="Create">+ Novo veiculo</a>
      </div>

      <div id="alerts"></div>

      <div class="table-shell">
        <table class="table table-hover align-middle mb-0" id="vehiclesTable">
          <thead>
            <tr>
              <th>Marca</th>
              <th>Modelo</th>
              <th>Matricula</th>
              <th>Ano</th>
              <th>Combustivel</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var v in Model.Items)
            {
                <tr>
                  <td>@v.Brand</td>
                  <td>@v.Model</td>
                  <td>@v.LicensePlate</td>
                  <td>@v.ManufacturingYear</td>
                  <td>@(v.Fuel.ToString())</td>
                  <td class="text-end">
                    <a class="btn btn-sm btn-primary" asp-action="Update" asp-route-id="@v.Id">Editar</a>
                    <form asp-action="Delete" method="post" class="d-inline">
                      @Html.AntiForgeryToken()
                      <input type="hidden" name="id" value="@v.Id" />
                      <input type="hidden" name="page" value="@currentPage" />
                      <input type="hidden" name="pageSize" value="@pageSize" />
                      <button class="btn btn-sm btn-danger" type="submit" onclick="return confirm('Delete this vehicle?');">Apagar</button>
                    </form>
                  </td>
                </tr>
            }
          </tbody>
        </table>
      </div>

      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mt-3">
        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
          <label for="pageSize" class="paging-note mb-0">Registos por pagina</label>
          <select id="pageSize" name="pageSize" class="form-select form-select-sm page-size-select" onchange="this.form.submit()">
            <option value="10" selected="@(pageSize == 10)">10</option>
            <option value="20" selected="@(pageSize == 20)">20</option>
            <option value="50" selected="@(pageSize == 50)">50</option>
          </select>
          <input type="hidden" name="page" value="1" />
        </form>

        <div class="d-flex align-items-center gap-2 flex-wrap justify-content-md-end">
          <span class="paging-note me-1">Pagina @currentPage de @(totalPages == 0 ? 1 : totalPages)</span>

          <a class="btn btn-sm btn-outline-secondary @(currentPage <= 1 ? "disabled" : "")"
             asp-action="Index"
             asp-route-page="@(currentPage - 1)"
             asp-route-pageSize="@pageSize"
             aria-disabled="@(currentPage <= 1)">
            Anterior
          </a>

          @if (totalPages > 0)
          {
              @for (var i = startPage; i <= endPage; i++)
              {
                  var activeClass = i == currentPage ? "btn-primary" : "btn-outline-secondary";
                  <a class="btn btn-sm @activeClass"
                     asp-action="Index"
                     asp-route-page="@i"
                     asp-route-pageSize="@pageSize">@i</a>
              }
          }

          <a class="btn btn-sm btn-outline-secondary @(currentPage >= totalPages ? "disabled" : "")"
             asp-action="Index"
             asp-route-page="@(currentPage + 1)"
             asp-route-pageSize="@pageSize"
             aria-disabled="@(currentPage >= totalPages)">
            Seguinte
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
