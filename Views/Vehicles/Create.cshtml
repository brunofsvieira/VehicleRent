@model VehicleRent.Models.ViewModels.VehicleViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Criar Veiculo";
}

<section class="vehicle-page py-4 py-lg-5">
  <div class="container">
    <div class="page-shell mx-auto">
      <p class="page-eyebrow mb-2">Gestao de frota</p>
      <h1 class="page-title mb-3">Novo veiculo</h1>
      <p class="page-subtitle mb-4">Preencha os dados abaixo para registar um novo veiculo.</p>
      <div id="alerts"></div>
      @await Html.PartialAsync("~/Views/Shared/_VehicleForm.cshtml", Model)
    </div>
  </div>
</section>

@section Scripts {
  @await Html.PartialAsync("~/Views/Shared/_ValidationScriptsPartial.cshtml")
}
