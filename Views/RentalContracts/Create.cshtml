@model VehicleRent.Models.ViewModels.RentalContractViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Criar Contrato";
}

<section class="vehicle-page py-4 py-lg-5">
  <div class="container">
    <div class="page-shell mx-auto" data-reveal>
      <div class="module-head mb-4">
        <p class="page-eyebrow mb-2">Gestão de contratos</p>
        <h1 class="page-title mb-2">Novo contrato de aluguer</h1>
        <p class="page-subtitle mb-0">Regista um contrato com cliente, Veículo, datas e quilometragem inicial.</p>
      </div>
      <div id="alerts"></div>
      @await Html.PartialAsync("~/Views/Shared/_RentalContractForm.cshtml", Model)
    </div>
  </div>
</section>

@section Scripts {
  @await Html.PartialAsync("~/Views/Shared/_ValidationScriptsPartial.cshtml")
}
