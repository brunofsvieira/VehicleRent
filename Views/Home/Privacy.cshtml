@{
    ViewData["Title"] = "Privacidade";
}

<section class="privacy-page py-4 py-lg-5">
    <div class="container">
        <div class="page-shell mx-auto" data-reveal>
            <p class="page-eyebrow mb-2">Informação Legal</p>
            <h1 class="page-title mb-3">Política de Privacidade</h1>
            <p class="page-subtitle mb-4">Esta aplição de demonstração guarda apenas os dados necessários para gerir os veículos registados.</p>

            <div class="privacy-card" data-reveal>
                <h2>Dados armazenados</h2>
                <p>Marca, modelo, ano de fabrico e tipo de combustível do Veículo.</p>
            </div>
            <div class="privacy-card" data-reveal>
                <h2>Finalidade</h2>
                <p>Permitir operações de criar, consultar, editar e remover registos de veículos.</p>
            </div>
            <div class="privacy-card" data-reveal>
                <h2>Contato</h2>
                <p>Para duvidas sobre tratamento de dados, usa os contactos.</p>
            </div>
        </div>
    </div>
</section>
