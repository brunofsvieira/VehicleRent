@{
    ViewData["Title"] = "Privacidade";
}

<section class="privacy-page py-4 py-lg-5">
    <div class="container">
        <div class="page-shell mx-auto">
            <p class="page-eyebrow mb-2">Informacao Legal</p>
            <h1 class="page-title mb-3">Politica de Privacidade</h1>
            <p class="page-subtitle mb-4">Esta aplicacao de demonstracao guarda apenas os dados necessarios para gerir os veiculos registados.</p>

            <div class="privacy-card">
                <h2>Dados armazenados</h2>
                <p>Marca, modelo, ano de fabrico e tipo de combustivel do veiculo.</p>
            </div>
            <div class="privacy-card">
                <h2>Finalidade</h2>
                <p>Permitir operacoes de criar, consultar, editar e remover registos de veiculos.</p>
            </div>
            <div class="privacy-card">
                <h2>Contato</h2>
                <p>Para duvidas sobre tratamento de dados, usa os canais internos do teu projeto.</p>
            </div>
        </div>
    </div>
</section>
